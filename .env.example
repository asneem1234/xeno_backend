# Database - SQLite (no setup required!)
DATABASE_URL="file:./dev.db"

# JWT Secret (Change this in production!)
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Shopify App Credentials (Get from Shopify Partners Dashboard)
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"
SHOPIFY_ACCESS_TOKEN="your-shopify-access-token"
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_SCOPES="read_customers,read_orders,read_products"
SHOPIFY_HOST="http://localhost:3000"

# Webhook Secret
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"

# Sync Schedule (Cron format - every 6 hours)
SYNC_CRON_SCHEDULE="0 */6 * * *"
